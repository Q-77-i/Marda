# 复制为项目根目录 .env 并填入真实密钥（.env 不进 git）
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=""
# SiliconFlow（rerank：bge-reranker-v2-m3；M3 起嵌入走本地 BGE-M3 容器，不再用它的嵌入）：https://siliconflow.cn 注册实名后获取
SILICONFLOW_API_KEY=""
# 账号体系 JWT 签名密钥（FR-23）：本地随机生成，勿用示例值
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
# Langfuse 可观测（P1-M4，FR-21）：https://cloud.langfuse.com 建项目后取 key
# 留空即整体降级为零开销（本地/CI 无需账号，面试链路不受影响）
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# 自托管或区域节点时改写（默认云端）
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
