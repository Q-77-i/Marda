# 复制为项目根目录 .env 并填入真实密钥（.env 不进 git）
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=""
# SiliconFlow（rerank：bge-reranker-v2-m3；M3 起嵌入走本地 BGE-M3 容器，不再用它的嵌入）：https://siliconflow.cn 注册实名后获取
SILICONFLOW_API_KEY=""
# 账号体系 JWT 签名密钥（FR-23）：本地随机生成，勿用示例值
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""
# Langfuse 可观测（P1-M4，FR-21）：https://cloud.langfuse.com 建项目后取 key
# 留空即整体降级为零开销（本地/CI 无需账号，面试链路不受影响）
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
# 自托管或区域节点时改写（默认云端）
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# 火山引擎
# 注意是**两把不同的 key、不通用**（P2-M5 探针实测，2026-10-02）：
# - 方舟 Ark（大模型，Bearer）：https://console.volcengine.com/ark → API Key
VOLCANO_API_KEY=""
# - 豆包语音（ASR，X-Api-Key）：https://console.volcengine.com/speech/new/setting/apikeys
#   需先在「开通管理」开通「豆包流式语音识别模型 2.0」；留空 = 语音通道整体降级为文字
VOLCANO_SPEECH_API_KEY=""
# 语音识别资源 id（新版控制台默认 2.0 小时版）；换服务版本时改这里，不动代码
VOLCANO_ASR_RESOURCE_ID="volc.seedasr.sauc.duration"
# TTS 音色（edge-tts，免费）：zh-CN-XiaoxiaoNeural（女）/ zh-CN-YunxiNeural（男）
TTS_VOICE="zh-CN-XiaoxiaoNeural"
# 上游保护与降级（P2-M9）：默认值即可用，一般不用改；压测/演示时可调
# 并发闸门按模型限流（DeepSeek 限流维度是**并发数**，账户级 flash 2500 / pro 500；
# 下面默认值是自设的保守上限，超限排队等待、等待超时即降级）
LLM_MAX_CONCURRENCY_FLASH="16"
LLM_MAX_CONCURRENCY_PRO="4"
LLM_ACQUIRE_TIMEOUT_S="30"
# 断路器：连续「上游不可用」失败达阈值 → 开路（冷却期内快速失败）→ 冷却后半开探针
LLM_BREAKER_THRESHOLD="5"
LLM_BREAKER_COOLDOWN_S="30"

