# 复制为项目根目录 .env 并填入真实密钥（.env 不进 git）
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# SiliconFlow（rerank：bge-reranker-v2-m3；M3 起嵌入走本地 BGE-M3 容器，不再用它的嵌入）：https://siliconflow.cn 注册实名后获取
SILICONFLOW_API_KEY=""

# 账号体系 JWT 签名密钥（FR-23）：本地随机生成，勿用示例值
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=""

# Langfuse 可观测（P1-M4，FR-21）：https://cloud.langfuse.com 建项目后取 key
# 留空即整体降级为零开销（本地/CI 无需账号，面试链路不受影响）
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# 自托管或区域节点时改写（默认云端）
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# 火山引擎
# 注意是**两把不同的 key、不通用**（P2-M5 探针实测，2026-10-02）：
# - 方舟 Ark（大模型，Bearer）：https://console.volcengine.com/ark → API Key
VOLCANO_API_KEY=""

# - 豆包语音（ASR，X-Api-Key）：https://console.volcengine.com/speech/new/setting/apikeys
#   需先在「开通管理」开通「豆包流式语音识别模型 2.0」；留空 = 语音通道整体降级为文字
VOLCANO_SPEECH_API_KEY=""

# 语音识别资源 id（新版控制台默认 2.0 小时版）；换服务版本时改这里，不动代码
VOLCANO_ASR_RESOURCE_ID="volc.seedasr.sauc.duration"

# TTS 音色（edge-tts，免费）：zh-CN-XiaoxiaoNeural（女）/ zh-CN-YunxiNeural（男）
TTS_VOICE="zh-CN-XiaoxiaoNeural"

# 上游保护与降级（P2-M9）：默认值即可用，一般不用改；压测/演示时可调
# 并发闸门按模型限流（DeepSeek 限流维度是**并发数**，账户级 flash 2500 / pro 500；
# 下面默认值是自设的保守上限，超限排队等待、等待超时即降级）
LLM_MAX_CONCURRENCY_FLASH="16"
LLM_MAX_CONCURRENCY_PRO="4"
LLM_ACQUIRE_TIMEOUT_S="30"

# 断路器：连续「上游不可用」失败达阈值 → 开路（冷却期内快速失败）→ 冷却后半开探针
LLM_BREAKER_THRESHOLD="5"
LLM_BREAKER_COOLDOWN_S="30"

# ===== P4 生产化（docs/P4-生产化.md）=====
# 三组开关各自独立，默认值 = **单机形态**（不依赖 PG/Redis 就能跑）。
# 生产 profile 把它们改成 postgres / postgres / redis，再配合 compose 的多 worker。

# ① 业务库后端：sqlite（默认，单机 / 单测）| postgres（生产）
DB_BACKEND="sqlite"
# postgres 模式必填；sqlite 模式忽略
DATABASE_URL="postgresql://marda:marda@postgres:5432/marda"
# 连接池（每 worker 一个池）
DB_POOL_MIN_SIZE="1"
DB_POOL_MAX_SIZE="5"
DB_CONNECT_TIMEOUT_S="10"

# ② checkpointer 后端：sqlite（默认）| postgres（多 worker 共享状态）
CHECKPOINT_BACKEND="sqlite"
# postgres 模式必填；**独立库**（不与业务库混在一起，升级方案 §4.1）
CHECKPOINT_DATABASE_URL="postgresql://marda:marda@postgres:5432/marda_checkpoints"
CHECKPOINT_POOL_MAX_SIZE="10"
# 每场保留最近 N 张快照 + 最终一张；调大安全，调小会丢更早的节点时间线
CHECKPOINT_RETENTION="20"

# ③ 协调后端：memory（默认，单进程）| redis（多 worker 共享）
COORDINATION_BACKEND="memory"
REDIS_URL="redis://redis:6379/0"
# 会话锁 TTL：要大于一轮最长耗时；worker 崩了靠它过期
INTERVIEW_LOCK_TTL_S="600"
# 单用户每分钟请求上限（超限 429；Redis 挂了时 fail open 放行）
USER_RATE_LIMIT_PER_MIN="30"
# 全局 LLM 并发槽（**跨 worker 共享**，不是每 worker 一份）
LLM_SLOTS_FLASH="16"
LLM_SLOTS_PRO="4"
# 槽位租约时长（超时自动释放，防止 worker 崩了永久占槽）
LLM_SLOT_LEASE_S="120"

# PostgreSQL 宿主机端口映射（本地开发用）
POSTGRES_HOST_PORT="55432"
